# Example only. Generate every secret yourself in Railway Variables.
KEY=replace-with-random-secret
SECRET=replace-with-a-different-random-secret
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-unique-long-password
PUBLIC_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
DB_CLIENT=pg
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
